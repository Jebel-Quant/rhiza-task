## Makefile (repo-owned) -- generated by `uvx rhiza-task shim > Makefile`
#
# `make` stays the front door; it just forwards to the pinned CLI instead of containing
# anything. RHIZA_TASK is the entire version contract -- bumping it is the migration.
RHIZA_TASK ?= rhiza-task@0.3.1

# uv is the one thing that cannot be delegated, because uv is what runs the CLI, and
# `make <anything>` has to work on a bare runner with no setup-uv step. Prepended so a
# runner carrying an older uv still resolves the pin above, and exported because every
# task body shells out to a bare `uv`/`uvx`.
INSTALL_DIR ?= $(abspath ./bin)
UVX ?= $(shell command -v uvx 2>/dev/null || echo $(INSTALL_DIR)/uvx)
export PATH := $(INSTALL_DIR):$(PATH)

.DEFAULT_GOAL := help

# The named tasks: the CI gates, the daily loop, and the documents. Spelled out rather than
# left to the catch-all so `make -p`, shell completion and a reader all see them, and so
# .PHONY can protect them -- `make book` next to a `book/` directory, or `paper` next to
# `paper/`, is "nothing to be done" otherwise. `make help` lists what this repo offers.
.PHONY: help \
        fmt test typecheck coverage \
        all deps docs-coverage license security rhiza-test \
        install clean \
        book paper presentation

help: $(UVX)
	@$(UVX) $(RHIZA_TASK) list

fmt: $(UVX)
	@$(UVX) $(RHIZA_TASK) fmt

test: $(UVX)
	@$(UVX) $(RHIZA_TASK) test

typecheck: $(UVX)
	@$(UVX) $(RHIZA_TASK) typecheck

coverage: $(UVX)
	@$(UVX) $(RHIZA_TASK) coverage

all: $(UVX)
	@$(UVX) $(RHIZA_TASK) all

deps: $(UVX)
	@$(UVX) $(RHIZA_TASK) deps

docs-coverage: $(UVX)
	@$(UVX) $(RHIZA_TASK) docs-coverage

license: $(UVX)
	@$(UVX) $(RHIZA_TASK) license

security: $(UVX)
	@$(UVX) $(RHIZA_TASK) security

rhiza-test: $(UVX)
	@$(UVX) $(RHIZA_TASK) rhiza-test

install: $(UVX)
	@$(UVX) $(RHIZA_TASK) install

clean: $(UVX)
	@$(UVX) $(RHIZA_TASK) clean

book: $(UVX)
	@$(UVX) $(RHIZA_TASK) book

paper: $(UVX)
	@$(UVX) $(RHIZA_TASK) paper

presentation: $(UVX)
	@$(UVX) $(RHIZA_TASK) presentation

# Everything else the CLI offers -- doctor, docker-*, lfs-*, the GitHub helpers, marimo,
# semgrep, todos, the testing extras, and the -clean/-pdf/-serve siblings above -- comes
# through here. A typo lands
# here too, and the CLI's "unknown task" error is the backstop. `RHIZA_TASK_GOAL` is `$@`
# named; recursive `=` because `$@` only has a value while make is running the rule.
RHIZA_TASK_GOAL = $@

%: $(UVX)
	@$(UVX) $(RHIZA_TASK) $(RHIZA_TASK_GOAL)

# A file target, so make's own up-to-date check is the idempotence: no probe to get wrong,
# no second invocation that re-downloads. The target is `$(UVX)` and not
# `$(INSTALL_DIR)/uvx` because an on-PATH uvx with no rule of its own is matched by the
# catch-all, whose prerequisite is that same file: `make: Circular ... dependency dropped`.
# `$(@D)` so an overridden `UVX=/somewhere/uvx` provisions /somewhere.
$(UVX):
	@echo "[INFO] uv not found; installing into $(@D)"
	@curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR="$(@D)" sh >/dev/null

# Repo-specific one-offs, and what `.rhiza/make.d/` fragments must move into. An explicit
# rule beats a pattern rule, so these win over the catch-all.
-include local.mk

# An included makefile is also a target make tries to remake, and with a match-anything
# rule in scope that attempt is routed to the CLI -- so every invocation used to open with
# "unknown task: local.mk". The Makefile needs the same: `$(UVX)` is a prerequisite a cold
# checkout creates, making the Makefile out of date, so make ran `uvx rhiza-task Makefile`
# and died right after installing uv. Empty recipes end both.
local.mk: ;
Makefile: ;
